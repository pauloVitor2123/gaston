{
  "name": "gaston",
  "version": "0.0.1",
  "private": true,
  "description": "Finanças do PV — conversational financial assistant for Telegram (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gaston-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gaston-db --remote",
    "db:seed:local": "wrangler d1 execute gaston-db --local --file=src/db/seeds.sql",
    "db:seed:remote": "wrangler d1 execute gaston-db --remote --file=src/db/seeds.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.112.0"
  }
}
